{
  "name": "tamify",
  "productName": "Tamify",
  "private": true,
  "version": "1.0.0",
  "description": "Tamify • Tamil Legacy Document OCR, PDF to Excel & Unicode DOCX Studio",
  "author": "Tamify",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:frontend": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-electron/preload.cjs",
    "build:icons": "node scripts/generate_icons.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && npm run build:electron",
    "electron:dev": "npm run build:electron && cross-env TAMIFY_DEV=true electron .",
    "electron:start": "npm run build && electron .",
    "package": "electron-forge package --config forge.config.cjs",
    "make": "electron-forge make --config forge.config.cjs",
    "make:windows": "electron-forge make --config forge.config.cjs --platform=win32 --arch=x64",
    "build:exe": "node scripts/build_windows_suite.mjs",
    "export:code": "node scripts/export_all_codes_zip.mjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron server.js out",
    "lint": "tsc --noEmit",
    "test": "tsx test-runner.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "electron-squirrel-startup": "^1.0.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "undici": "^8.10.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "caxa": "^3.0.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "esbuild": "^0.25.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.5.0"
  }
}
